#!/bin/bash
# Runs <command> on every Proxmox node in the cluster, optionally in parallel

# shellcheck disable=SC2207

SCRIPT_NAME="$(basename "$0")"
PARALLEL=false
SSH_TIMEOUT=5

# Parse optional flag
if [[ "$1" == "--parallel" || "$1" == "-p" ]]; then
    PARALLEL=true
    shift
fi

if [ $# -eq 0 ]; then
    echo "Usage: $SCRIPT_NAME [--parallel|-p] <command>"
    exit 1
fi

COMMAND="$*"
LOCAL_NODE=$(hostname)

# Grab node names from the cluster
NODES=($(pvecm nodes | awk '/Nodeid/{flag=1; next} flag && NF>=3 {print $3}'))

# Reorder nodes so the local node runs last
NODES=(
  $(printf "%s\n" "${NODES[@]}" | grep -v "^$LOCAL_NODE$")
  "$LOCAL_NODE"
)

# Resolve node IPs before executing commands
declare -A NODE_IPS

echo "[ INFO ] Resolving node IPs..."

while IFS=$'\t' read -r NODE IP; do
    NODE_IPS["$NODE"]="$IP"

    if [[ -z "$IP" ]]; then
        echo "[ WARNING ] Could not determine IP for $NODE, skipping."
    else
        echo "[ $NODE ] $IP"
    fi
done < <(
    for NODE in "${NODES[@]}"; do
        (
            IP=$(pvesh get "/nodes/$NODE/network" --output-format json |
                 jq -r '.[] | select(.iface=="vmbr0") | .address | split("/")[0]')
            printf '%s\t%s\n' "$NODE" "$IP"
        ) &
    done
    wait
)

run_command() {
    local NODE="$1"
    local NODE_IP="${NODE_IPS[$NODE]}"

    [[ -z "$NODE_IP" ]] && return

    echo "[ $NODE ]"
    
    if [[ "$NODE" == "$LOCAL_NODE" ]]; then
        bash -c "$COMMAND"
    else
        ssh -o BatchMode=yes -o ConnectTimeout=$SSH_TIMEOUT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@"$NODE_IP" "export TERM=xterm; $COMMAND" 2>/dev/null
        SSH_EXIT=$?
        if [[ $SSH_EXIT -ne 0 ]]; then
            echo -e "[ WARNING ] SSH to $NODE ($NODE_IP) failed with exit code $SSH_EXIT"
        fi
    fi
}

for NODE in "${NODES[@]}"; do
    if $PARALLEL; then

        [[ "$NODE" == "$LOCAL_NODE" ]] && sleep $SSH_TIMEOUT
        run_command "$NODE" &
    else
        run_command "$NODE"
    fi
done

# Wait for all background jobs if parallel
if $PARALLEL; then
    wait
fi
