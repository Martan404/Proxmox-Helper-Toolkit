#!/bin/bash
# Runs <command> on every Proxmox node in the cluster, optionally in parallel

# shellcheck disable=SC2207

SCRIPT_NAME="$(basename "$0")"
PARALLEL=false
COMMAND="$*"
LOCAL_NODE=$(hostname)
SSH_CONTROL_DIR="/tmp/proxmox-ssh-$$"
mkdir -p "$SSH_CONTROL_DIR"
chmod 700 "$SSH_CONTROL_DIR"

# Parse optional flag
if [[ "$1" == "--parallel" || "$1" == "-p" ]]; then
    PARALLEL=true
    shift
fi

if [ $# -eq 0 ]; then
    echo "Usage: $SCRIPT_NAME [--parallel|-p] <command>"
    exit 1
fi

# Get node names in the cluster
NODES=($(pvecm nodes | awk '/Nodeid/{flag=1; next} flag && NF>=3 {print $3}'))

# Reorder nodes so the local node runs last
NODES=(
  $(printf "%s\n" "${NODES[@]}" | grep -v "^$LOCAL_NODE$")
  "$LOCAL_NODE"
)

cleanup() {
    for NODE in "${NODES[@]}"; do
        NODE_IP="${NODE_IPS[$NODE]}"

        [[ -z "$NODE_IP" || "$NODE" == "$LOCAL_NODE" ]] && continue

        ssh -o ControlPath="$SSH_CONTROL_DIR/%C" -O exit root@"$NODE_IP" 2>/dev/null || true
    done

    rm -rf "$SSH_CONTROL_DIR"
}
trap cleanup EXIT

run_command() {
    local NODE="$1"
    local NODE_IP="${NODE_IPS[$NODE]}"

    [[ -z "$NODE_IP" ]] && return

    echo "[ $NODE ]"
    
    if [[ "$NODE" == "$LOCAL_NODE" ]]; then
        bash -c "$COMMAND"
    else
        ssh -o ControlMaster=no -o ControlPath="$SSH_CONTROL_DIR/%C" root@"$NODE_IP" "export TERM=xterm; $COMMAND"
    fi
}

# Resolve node IPs
declare -A NODE_IPS

while IFS=$'\t' read -r NODE IP; do
    NODE_IPS["$NODE"]="$IP"

    if [[ -z "$IP" ]]; then
        echo "[ WARNING ] Could not determine IP for $NODE, skipping."
    fi
done < <(
    for NODE in "${NODES[@]}"; do
        (
            IP=$(pvesh get "/nodes/$NODE/network" --output-format json |
                 jq -r '.[] | select(.iface=="vmbr0") | .address | split("/")[0]')
            printf '%s\t%s\n' "$NODE" "$IP"
        ) &
    done
    wait
)

# Establish SSH connections
for NODE in "${NODES[@]}"; do
    NODE_IP="${NODE_IPS[$NODE]}"

    [[ -z "$NODE_IP" || "$NODE" == "$LOCAL_NODE" ]] && continue

    (
        ssh -o BatchMode=yes -o ConnectTimeout="5" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ControlMaster=yes -o ControlPersist=yes -o ControlPath="$SSH_CONTROL_DIR/%C" -fN root@"$NODE_IP" 2>/dev/null

        if [[ $? -ne 0 ]]; then
            echo "[ WARNING ] SSH to $NODE ($NODE_IP) failed"
        fi
    ) &
done

wait

# Execute command
for NODE in "${NODES[@]}"; do
    if $PARALLEL; then

        [[ "$NODE" == "$LOCAL_NODE" ]] && sleep 0.2
        run_command "$NODE" &
    else
        run_command "$NODE"
    fi
done

# Wait for all background jobs if parallel
if $PARALLEL; then
    wait
fi
