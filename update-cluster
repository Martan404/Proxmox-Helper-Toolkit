#!/bin/bash
# Updates the entire Proxmox cluster

# shellcheck disable=SC2016

PARALLEL=false

# Parse optional flag
if [[ "$1" == "--parallel" || "$1" == "-p" ]]; then
    PARALLEL=true
    shift
fi

if [ $# -gt 0 ]; then
    echo "Usage: $0 [--parallel|-p]"
    exit 1
fi

run_command() {
    if [ "$PARALLEL" = true ]; then
        run-on-cluster -p "$1"
    else
        run-on-cluster "$1"
    fi
}

read -rp "Remove old packages after updating? (y/N): " answer_remove
read -rp "Reboot after updating? (y/N): " answer_reboot

echo "Updating all running containers..."
run_command 'var_backup=no var_container=all_running var_unattended=yes var_skip_confirm=yes var_auto_reboot=yes bash -c "$(curl -fsSL https://raw.githubusercontent.com/community-scripts/ProxmoxVE/main/tools/pve/update-apps.sh)"'

echo "Updating system packages..."
run_command 'apt --assume-yes update && apt --assume-yes upgrade'

case "$answer_remove" in
    [yY]|[yY][eE][sS])
        echo "Removing old system packages..."
        run_command "apt --assume-yes autoremove"
        ;;
esac

echo "Cluster update complete"

case "$answer_reboot" in
    [yY]|[yY][eE][sS])
        run-on-cluster "reboot"
        ;;
    *)
        exit 0
        ;;
esac